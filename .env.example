# Application Configuration
ZYLAR_ENVIRONMENT=development
ZYLAR_LOG_LEVEL=INFO
ZYLAR_API_HOST=127.0.0.1
ZYLAR_API_PORT=8000
ZYLAR_REQUEST_TIMEOUT_SECONDS=10
ZYLAR_MAX_BATCH_SIZE=500
ZYLAR_MAX_QUERY_WINDOW_MINUTES=60
ZYLAR_ENABLE_INGESTION_SCHEDULER=true
ZYLAR_MAX_WORKFLOW_CONCURRENCY=5

# Elasticsearch Configuration & Security
# Local development: http://127.0.0.1:9200
# Production requirement: Must use HTTPS (e.g. https://elasticsearch:9200)
# Provide either basic_auth (username + password) OR api_key.
ZYLAR_ELASTICSEARCH_URL=http://127.0.0.1:9200
ZYLAR_ELASTICSEARCH_INDEX=zylar-logs
ZYLAR_ELASTICSEARCH_USERNAME=elastic
ZYLAR_ELASTICSEARCH_PASSWORD=replace-with-your-secure-password
# Optional API Key (mutually exclusive with password in production):
# ZYLAR_ELASTICSEARCH_API_KEY=your-elasticsearch-api-key
# TLS & Certificate Authority settings
ZYLAR_ELASTICSEARCH_VERIFY_CERTS=true
# ZYLAR_ELASTICSEARCH_CA_CERTS=/path/to/custom/ca-bundle.crt

# PostgreSQL Connection & Pool Budgets
# Local development container binds to port 5434 with database 'zylar_db'.
# In Phase 7+ role-segregated deployments:
#   - Runtime app/worker uses least-privilege role: postgresql+psycopg://zylar_app:<PASSWORD>@127.0.0.1:5434/zylar_db
#   - Migrations/schema management uses admin role: postgresql+psycopg://zylar_migration:<PASSWORD>@127.0.0.1:5434/zylar_db
ZYLAR_DATABASE_URL=postgresql+psycopg://zylar:<YOUR_PASSWORD>@127.0.0.1:5434/zylar_db

# Segregated Database Pool Budgets (Single-instance constraint: API + Worker + 5 reserved <= 50)
ZYLAR_API_DB_POOL_SIZE=10
ZYLAR_API_DB_MAX_OVERFLOW=10
ZYLAR_WORKER_DB_POOL_SIZE=5
ZYLAR_WORKER_DB_MAX_OVERFLOW=5

# Local Inference Adapter (Ollama)
ZYLAR_OLLAMA_URL=http://127.0.0.1:11434
ZYLAR_OLLAMA_MODEL=mistral

# Authentication Bootstrap Settings
ZYLAR_AUTH_SIGNING_KEY=replace-with-a-long-random-secret
ZYLAR_BOOTSTRAP_ADMIN_USERNAME=zylar_admin
ZYLAR_BOOTSTRAP_ADMIN_PASSWORD=change-admin-password-in-production

# Application
ZYLAR_ENVIRONMENT=development
ZYLAR_LOG_LEVEL=INFO
ZYLAR_API_HOST=127.0.0.1
ZYLAR_API_PORT=8000
ZYLAR_REQUEST_TIMEOUT_SECONDS=10
ZYLAR_MAX_BATCH_SIZE=500
ZYLAR_MAX_QUERY_WINDOW_MINUTES=60

# Services. Do not commit real credentials.
ZYLAR_ELASTICSEARCH_URL=http://127.0.0.1:9200
ZYLAR_ELASTICSEARCH_INDEX=zylar-logs
ZYLAR_DATABASE_URL=postgresql+psycopg://zylar:change-me@127.0.0.1:5432/zylar
ZYLAR_OLLAMA_URL=http://127.0.0.1:11434
ZYLAR_OLLAMA_MODEL=mistral

# Temporary compatibility setting. Removed when Slice 4 replaces the legacy
# external classifier with the local Ollama adapter.
ZYLAR_LEGACY_CLASSIFIER_MODEL=gpt-3.5-turbo

# Authentication is introduced in Slice 3. Set a unique secret before enabling it.
ZYLAR_AUTH_SIGNING_KEY=replace-with-a-long-random-secret

# Application
ZYLAR_ENVIRONMENT=development
ZYLAR_LOG_LEVEL=INFO
ZYLAR_API_HOST=127.0.0.1
ZYLAR_API_PORT=8000
ZYLAR_REQUEST_TIMEOUT_SECONDS=10
ZYLAR_MAX_BATCH_SIZE=500
ZYLAR_MAX_QUERY_WINDOW_MINUTES=60

# Services. Do not commit real credentials.
ZYLAR_ELASTICSEARCH_URL=http://elastic:<YOUR_PASSWORD>@127.0.0.1:9200
ZYLAR_ELASTICSEARCH_INDEX=zylar-logs
ZYLAR_ELASTICSEARCH_USERNAME=zylar_elastic
ZYLAR_ELASTICSEARCH_PASSWORD=replace-with-your-secure-password
ZYLAR_DATABASE_URL=postgresql+psycopg://zylar:<YOUR_PASSWORD>@127.0.0.1:5434/zylar_db
ZYLAR_OLLAMA_URL=http://127.0.0.1:11434
ZYLAR_OLLAMA_MODEL=mistral

# Authentication bootstrap settings.
ZYLAR_AUTH_SIGNING_KEY=replace-with-a-long-random-secret
ZYLAR_BOOTSTRAP_ADMIN_USERNAME=zylar_admin
ZYLAR_BOOTSTRAP_ADMIN_PASSWORD=change-admin-password-in-production
